# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Test & type-check caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Model weights & checkpoints ---
# encoders here are ~1-4 MB fp32, but training runs produce far larger
# artifacts; keep them out of git and use a release or artifact store
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
checkpoints/

# --- SCADA / vibration data ---
# raw turbine data is large and frequently proprietary. Nothing under data/
# is tracked. Add small synthetic fixtures explicitly with `git add -f`.
data/
raw/
*.csv
*.parquet
*.h5
*.hdf5
*.npy
*.npz
*.tdms
*.mat

# --- Experiment tracking / logs ---
runs/
outputs/
wandb/
lightning_logs/
mlruns/
tensorboard/
*.log

# --- Presentations & documents ---
# binary, so diffs are useless and every re-save rewrites the whole blob.
# Slide decks live in shared drives; git tracks the code they describe.
*.pptx
*.ppt
*.docx
*.doc
*.xlsx
*.xls

# --- Figures ---
# Plots are OUTPUTS: regenerable from the run's csv plus train_nbm.py
# --plot-only, so committing them means a binary that silently drifts from the
# numbers it claims to show. Anything under runs/ is already ignored; this
# catches strays elsewhere.
#
# figures/ is the deliberate exception -- a figure you have chosen to keep for a
# report or a deck, promoted by hand rather than dropped there by a script.
*.png
*.jpg
*.svg
*.pdf
!figures/**

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
